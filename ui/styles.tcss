Screen {
    align: center middle;
    overflow-y: scroll;
}

Vertical {
    width: auto;
    height: auto;
    padding: 1;
}

Horizontal {
    width: auto;
    padding: 1;
}

Center > Horizontal {
    height: auto;
}

DataTable {
    width: auto;
    height: auto;
    margin-bottom: 1;
    overflow-x: auto;
}

DataTable > .datatable--cursor {
    background: darkred;
    color: white;
}

.home-container {
    width: 50;
    padding: 2;
}

.gap-top {
    margin-top: 1;
}

.width-50 {
    width: 50;
    text-align: center;
}


Input {
    margin-bottom: 1;
    min-width: 50;
}

Input:focus {
    border: solid red;
}

Select:hover {
    border: solid red;
}

Select {
   width: auto; 
}

.verticalSelect {
    width: auto;
    padding: 0;
    margin-bottom: 1;
}


Button {
    width: auto;
}

.error {
    color: red;
    text-style: bold;
}

.success {
    color: green;
    text-style: bold;
}

.banner {
    width: auto;
    padding-top: 2;
}

.gap-left {
    margin-left: 1;
}

OptionList {
    border: solid red;
}

OptionList > .option-list--option-highlighted {
    background: darkred;
    color: white;
}

.table-buttons {
    width: 100;
    align-horizontal: center;
}

SelectionList {
    padding: 1;
    border: solid red;
    width: 1fr;
}

Pretty {
    width: 1fr;
    border: solid red;
}

Horizontal > Vertical {
    width: 1fr;
    height: auto;
}

Verical > Pretty {
    height: auto;
}

RadioSet:focus {
    border: solid red;
}

RadioButton:hover {
    background: darkred;
    color: white;
}

RadioButton:focus {
    background: darkred;
    color: white;
}